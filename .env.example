# -------------------------------------------------------
# life-dashboard — environment configuration
#
# On the server this file is NOT kept in plaintext: encrypt it with
#   sudo lifedash-env import /path/to/filled-in.env
# (systemd-creds, TPM-bound). /srv/lifedash/app/.env is a symlink to the
# decrypted copy in tmpfs. For local dev, copy to .env and edit.
# NEVER commit .env to version control.
# -------------------------------------------------------

# --- Application ---
APP_ENV=production          # production | development
APP_URL=https://dash.yourdomain.com
APP_TIMEZONE=America/Chicago
APP_DEBUG=false
# PostgreSQL migrations run at deploy time (lifedash-deploy). Leave false in production.
AUTO_MIGRATE=false

# --- Database ---
DB_DRIVER=pgsql             # pgsql (supported) | sqlite (legacy import source / offline dev)

# PostgreSQL on the server: Unix socket + peer auth — the lifedash OS user maps to the
# lifedash role, so no password exists. Leave DB_HOST/DB_PASS empty in that case.
DB_PGSQL_SOCKET_DIR=/var/run/postgresql
DB_NAME=lifedash
DB_USER=lifedash
DB_PASS=
# TCP instead (laptop dev, or a remote PostgreSQL): comment out DB_PGSQL_SOCKET_DIR and set
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_CONNECT_TIMEOUT=5

# SQLite (only when DB_DRIVER=sqlite)
DB_SQLITE_PATH=../storage/dashboard.db

# --- Auth ---
# Random 64-char string — generate with: openssl rand -hex 32
# MIGRATING FROM personal-dashboard: copy the OLD value. It signs sessions and encrypts the
# stored Dropbox/S3 credentials; a new value makes those unreadable.
APP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# --- Weather (OpenWeatherMap free tier) ---
# https://openweathermap.org/api — free account gives 1000 calls/day
OWM_API_KEY=

# --- Stocks (Alpha Vantage free tier) ---
# https://www.alphavantage.co/support/#api-key — free: 25 requests/day
ALPHAVANTAGE_API_KEY=
STOCK_CACHE_TTL=14400       # seconds (4 hours) per-symbol file cache

# --- Flight tracking ---
# opensky | flightaware
FLIGHT_PROVIDER=opensky
FLIGHT_POLL_MINUTES=30
FLIGHT_PURGE_HOURS=12
# OpenSky OAuth2 — https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Optional FlightAware AeroAPI personal tier
FLIGHTAWARE_API_KEY=

# --- Package tracking (direct carrier APIs) ---
PACKAGE_POLL_MINUTES=120
PACKAGE_PURGE_DAYS=7
SHARE_LINK_PURGE_HOURS=24
PACKAGE_MAX_PER_USER=10
# Use sandbox endpoints for development (UPS CIE + FedEx sandbox)
PACKAGES_SANDBOX=false
# UPS — https://developer.ups.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_USE_SANDBOX=false
# FedEx — https://developer.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_USE_SANDBOX=false
# DHL Shipment Tracking (Unified) — https://developer.dhl.com
DHL_API_KEY=
# Link-only carriers (USPS, Amazon, OnTrac, LaserShip) need no env keys — deep links only

# --- Private file storage (Cloud clipboards → Files tab) ---
FILES_MAX_BYTES=52428800
FILES_MAX_PER_USER=25
FILES_QUOTA_BYTES=524288000

# --- Cloud storage (optional — one provider per user: dropbox | s3) ---
# Dropbox app credentials: per user on Cloud clipboards → Files (encrypted in user_preferences).
# Admins: shared folder name + quota at Settings → Cloud storage setup (encrypted DB overrides below).
CLOUD_ROOT_FOLDER_NAME=PersonalDashboard
CLOUD_FILES_QUOTA_BYTES=5368709120
# OAuth redirect URI (each user's Dropbox app must register this):
#   {APP_URL}/api/storage/oauth/callback/dropbox
# S3 credentials are per-user in settings (not env); endpoint defaults to AWS.

# --- RSS Feed Cache ---
RSS_CACHE_DIR=../storage/cache/rss
RSS_CACHE_TTL=1800          # seconds (30 minutes)
RSS_ITEMS_PER_FEED=10
RSS_READER_ITEMS_PER_FEED=15
RSS_MAX_CUSTOM_FEEDS=10
RSS_CACHE_MAX_AGE_DAYS=14

# --- Session ---
SESSION_LIFETIME=86400      # seconds (24 hours)
SESSION_SECURE=true         # true with HTTPS (setup.sh manages this); false only while the UI is HTTP-only

# --- Cron log retention ---
CRON_LOG_RETENTION_DAYS=10  # scripts/prune_cron_logs.php keeps this many days of lines

# --- Local embeddings (optional) ---
# When set, saving a page asks Ollama for a vector so semantic search works
# without the agent supplying one. Leave blank to skip.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Recent posts for the X widget. X has no public feed. Leave blank and the widget explains how to set this.
# X_BEARER_TOKEN=

# Reddit tracking uses public JSON with no keys. If Reddit refuses the server,
# create a script app at https://www.reddit.com/prefs/apps and set these.
# The User-Agent should name this server. Settings → Setup can store the same values.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=web:life-dashboard:1.0 (by /u/yourname)

# --- Public hostnames (Cloudflare Tunnel) ---
# Generated share links and the OAuth issuer use PUBLIC_BASE_URL when it is set.
# Leave it blank to keep using APP_URL. APP_URL stays the LAN origin (Dropbox redirect).
# PUBLIC_BASE_URL=https://dash.yourdomain.com

# --- MCP server (Python, port 8765) ---
# MCP_BIND=all listens on 0.0.0.0. MCP_HOST is ignored, so a leftover 127.0.0.1
# does not change the bind. Set MCP_BIND=loopback only after every existing
# client of http://<this-host>:8765/mcp has moved to the tunnel URL, and only
# if you also want the LAN port closed. That needs a restart of lifedash-mcp.
# MCP_BIND=all
# Unset means true. Settings → Agents can override this without a restart and
# without changing the listen address. Off rejects direct http://<ip>:8765
# with 403 and names MCP_PUBLIC_URL. Tunnel HTTPS still works.
# MCP_ALLOW_PLAIN_HTTP=true
# MCP_API_BASE=http://127.0.0.1
# MCP_PORT=8765
# Address you paste into a Claude custom connector. It must end in /mcp.
# MCP_PUBLIC_URL=https://mcp.yourdomain.com/mcp
