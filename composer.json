{
    "name": "davidmcferrin-spec/life-dashboard",
    "description": "Self-hosted life dashboard — widgets, life tracking, second brain, MCP for AI assistants (evolved from personal-dashboard)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Dashboard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dashboard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "lint:sql": "php scripts/sql-lint-pgsql.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
