# /etc/lifedash/backup.env — root:root 0600. Copy, fill in ONE target, then:
#   sudo lifedash-backup init && sudo systemctl start lifedash-backup
#
# Restic encrypts client-side with the password below. LOSE THE PASSWORD = LOSE THE BACKUPS.
# Store it in your password manager as well as on this box.
RESTIC_PASSWORD_FILE=/etc/lifedash/restic.pass

# --- Option A: S3 (AWS, Backblaze B2 S3 API, Wasabi, …) -----------------
# RESTIC_REPOSITORY=s3:https://s3.us-east-1.amazonaws.com/your-bucket/lifedash
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Use a key restricted to this one bucket/prefix.

# --- Option B: Dropbox via rclone -----------------------------------------
# One-time: sudo rclone config   → new remote "dropbox", type dropbox (browser auth)
# RESTIC_REPOSITORY=rclone:dropbox:Apps/lifedash-backups

# Local pg_dump retention (days) in /var/backups/lifedash
LOCAL_KEEP_DAYS=7
