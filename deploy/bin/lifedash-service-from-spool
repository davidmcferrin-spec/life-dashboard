#!/usr/bin/env bash
# Drain /var/lib/lifedash/service/incoming. PHP only creates the request file.
set -euo pipefail

SOURCE=$(readlink -f "$0")
APP_DIR=$(CDPATH='' cd -- "$(dirname -- "$SOURCE")/../.." && pwd)
# shellcheck source=deploy/lib/deploy-guard.sh
source "$APP_DIR/deploy/lib/deploy-guard.sh"
SPOOL=/var/lib/lifedash/service
INCOMING=$SPOOL/incoming
STATE=$SPOOL/state
TOKEN_FILE=/etc/lifedash/cloudflared.token
UNIT_SRC=$APP_DIR/deploy/systemd/cloudflared.service
LOCK=$STATE/service.lock

log() { echo "[lifedash-service] $*"; }
die() { echo "[lifedash-service] ERROR: $*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "run as root"
install -d -m 0750 "$STATE"
exec 9>"$LOCK"
if ! flock -n 9; then
    log "another service action holds the lock"
    exit 0
fi

write_token() {
    local token=$1 tmp
    install -d -o root -g root -m 0750 /etc/lifedash
    tmp=$(mktemp /etc/lifedash/cloudflared.token.XXXXXX)
    printf '%s\n' "$token" > "$tmp"
    chown root:root "$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$TOKEN_FILE"
}

cloudflared_flags() {
    CF_ACTIVE=0
    CF_OURS=0
    CF_TOKEN=0
    systemctl is-active --quiet cloudflared && CF_ACTIVE=1
    lifedash_cloudflared_is_ours && CF_OURS=1
    [[ -s $TOKEN_FILE ]] && CF_TOKEN=1
    CF_ACTION=$(lifedash_cloudflared_action "$CF_ACTIVE" "$CF_OURS" "$CF_TOKEN")
}

install_unit() {
    cloudflared_flags
    # An already-running tunnel keeps its unit. This does not add a second one.
    if [[ $CF_ACTION != install ]]; then
        log "left the existing cloudflared service in place"
        return 1
    fi
    [[ -f $UNIT_SRC ]] || die "missing $UNIT_SRC"
    install -m 0644 "$UNIT_SRC" /etc/systemd/system/cloudflared.service
    systemctl daemon-reload
}

write_status() {
    local connected=$1 detail=$2 existing=${3:-0}
    python3 - "$STATE/status.json" "$connected" "$detail" "$existing" << 'PY'
import json
import sys
from datetime import datetime, timezone

path, connected, detail, existing = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
doc = {
    "connected": connected == "1",
    "existing": existing == "1",
    "detail": detail,
    "checked_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
with open(path, "w", encoding="utf-8") as fh:
    fh.write(json.dumps(doc) + "\n")
PY
    chgrp lifedash "$STATE/status.json" 2>/dev/null || true
    chmod 0640 "$STATE/status.json" 2>/dev/null || true
}

record_tunnel() {
    cloudflared_flags
    if [[ $CF_ACTIVE == 1 && $CF_OURS != 1 ]]; then
        write_status 1 "Running" 1
        return 0
    fi
    if [[ $CF_ACTIVE == 1 ]]; then
        write_status 1 "Connected" 0
        return 0
    fi
    write_status 0 "Not connected" 0
}

leave_existing() {
    cloudflared_flags
    [[ $CF_ACTIVE == 1 && $CF_ACTION == skip ]]
}

run_one() {
    local file=$1 base id action token parsed
    base=$(basename "$file")
    [[ $base =~ ^[0-9a-f]{32}\.json$ ]] || {
        log "ignoring $base"
        rm -f -- "$file"
        return 0
    }
    id=${base%.json}
    if ! parsed=$(python3 - "$file" << 'PY'
import json
import sys

data = json.load(open(sys.argv[1], encoding="utf-8"))
action = str(data.get("action") or "")
token = str(data.get("token") or "")
known = {
    "restart-mcp",
    "tunnel-start",
    "tunnel-stop",
    "tunnel-restart",
    "tunnel-status",
    "tunnel-clear",
}
if action not in known:
    raise SystemExit(2)
sys.stdout.write(action + "\n" + token)
PY
    ); then
        log "rejected $id"
        rm -f -- "$file"
        return 0
    fi
    action=${parsed%%$'\n'*}
    token=${parsed#*$'\n'}
    rm -f -- "$file"
    case "$action" in
        restart-mcp)
            systemctl restart lifedash-mcp
            log "restarted lifedash-mcp"
            ;;
        tunnel-clear)
            if leave_existing; then
                log "left the existing cloudflared service running"
                record_tunnel
                return 0
            fi
            rm -f -- "$TOKEN_FILE"
            systemctl stop cloudflared >/dev/null 2>&1 || true
            write_status 0 "stopped" 0
            ;;
        tunnel-stop)
            if leave_existing; then
                log "left the existing cloudflared service running"
                record_tunnel
                return 0
            fi
            systemctl stop cloudflared >/dev/null 2>&1 || true
            write_status 0 "stopped" 0
            ;;
        tunnel-start | tunnel-restart)
            if leave_existing; then
                log "left the existing cloudflared service running"
                record_tunnel
                return 0
            fi
            if [[ -z $token ]]; then
                log "no token for $action"
                record_tunnel
                return 0
            fi
            write_token "$token"
            if ! install_unit; then
                record_tunnel
                return 0
            fi
            systemctl enable cloudflared >/dev/null
            systemctl restart cloudflared
            record_tunnel
            ;;
        tunnel-status)
            record_tunnel
            ;;
        *)
            log "unknown action $action"
            ;;
    esac
}

shopt -s nullglob
files=("$INCOMING"/*.json)
for file in "${files[@]}"; do
    run_one "$file"
done
