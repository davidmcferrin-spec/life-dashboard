#!/usr/bin/env bash
# lifedash-perms — apply the ownership/permission model to /srv/lifedash.
# Called by provision.sh and lifedash-deploy (a fresh git clone is all root:root).
#
#   /srv/lifedash, app/          root:lifedash, others may traverse (o+x) only
#   app/ (code)                  root:lifedash, group read, no access for others
#   app/public/                  world-readable — Apache (www-data) serves static assets
#   app/storage/                 lifedash:lifedash, writable by the app only
#
# www-data is deliberately NOT in the lifedash group, so it can never read code
# outside public/, the .env symlink target, or storage/.
set -euo pipefail

BASE=${LIFEDASH_BASE_DIR:-/srv/lifedash}
APP=$BASE/app
USER_=lifedash

# chmod follows symlinks. venv/bin/python points at the system interpreter, so
# only real files and directories are changed.
lifedash_expose_venv() {
    local venv=$1
    local group=${2:-lifedash}
    [[ -d $venv ]] || return 0
    if [[ $EUID -eq 0 ]]; then
        chown -R root:"$group" "$venv"
    fi
    find "$venv" -type d -exec chmod 0750 {} +
    find "$venv" -type f -exec chmod 0640 {} +
    if [[ -d $venv/bin ]]; then
        find "$venv/bin" -type f -exec chmod 0750 {} +
    fi
}

# chmod lines that touch the checkout. Capital X keeps a file's executable bit
# as git recorded it: a 100644 file stays non-executable, a 100755 file stays
# executable. Do not chmod +x tracked files here.
lifedash_apply_code_modes() {
    local app=$1
    chmod -R u+rwX,g+rX,g-w,o-rwx "$app"
    chmod o+x "$app"
    if [[ -d $app/public ]]; then
        chmod -R o+rX "$app/public"
    fi
    if [[ -d $app/storage ]]; then
        chmod -R u+rwX,g+rwX,o-rwx "$app/storage"
    fi
    lifedash_allow_fetch "$app"
}

# Fetch writes refs and objects. The working tree stays group read-only.
# config and hooks stay group read-only so the app cannot retarget origin
# or install a hook that root git would run.
lifedash_allow_fetch() {
    local app=$1
    [[ -d $app/.git ]] || return 0
    git -C "$app" -c "safe.directory=$app" config core.sharedRepository group
    chmod -R u+rwX,g+rwX,o-rwx "$app/.git"
    find "$app/.git" -type d -exec chmod g+s {} +
    if [[ -f $app/.git/config ]]; then
        chmod g-w "$app/.git/config"
    fi
    if [[ -d $app/.git/hooks ]]; then
        chmod -R g-w "$app/.git/hooks"
    fi
}

# Porcelain of tracked changes, including file-mode changes. Empty when clean.
lifedash_tracked_dirt() {
    local app=$1
    [[ -e $app/.git ]] || return 0
    git -C "$app" -c "safe.directory=$app" -c core.fileMode=true status --porcelain --untracked-files=no
}

if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
    return 0
fi

[[ $EUID -eq 0 ]] || { echo "lifedash-perms: run as root" >&2; exit 1; }
[[ -d $APP ]] || { echo "lifedash-perms: $APP not found" >&2; exit 66; }

chown root:"$USER_" "$BASE"
chmod 0751 "$BASE"

# Code: read-only to the app user, invisible to everyone else…
chown -R root:"$USER_" "$APP"
before_dirt=$(lifedash_tracked_dirt "$APP")
lifedash_apply_code_modes "$APP"
# Executable bits come from git (mode 100755). A local chmod +x dirties the
# worktree and blocks git pull --ff-only, so this only warns.
for f in "$APP/setup.sh" "$APP/deploy/provision.sh" "$APP"/deploy/bin/*; do
    if [[ -f $f && ! -x $f ]]; then
        echo "lifedash-perms: $f is not executable — commit it as git mode 100755; do not chmod it on the server" >&2
    fi
done

# Writable state.
for d in storage storage/logs storage/cache storage/sessions storage/uploads; do
    install -d "$APP/$d"
done
chown -R "$USER_":"$USER_" "$APP/storage"
lifedash_apply_code_modes "$APP"
after_dirt=$(lifedash_tracked_dirt "$APP")
if [[ $before_dirt != "$after_dirt" ]]; then
    echo "lifedash-perms: permission update dirtied tracked files:" >&2
    echo "$after_dirt" >&2
    exit 1
fi

lifedash_expose_venv "$BASE/venv" "$USER_"

# The deploy that pulls this file still finishes inside the previous
# lifedash-deploy process. Units installed here are what that deploy applies.
if getent group "$USER_" >/dev/null 2>&1 && [[ -f /etc/systemd/system/lifedash-mcp.service ]]; then
    # shellcheck source=deploy/lib/deploy-guard.sh
    source "$APP/deploy/lib/deploy-guard.sh"
    lifedash_install_runtime_units "$APP" "$USER_"
fi
