# JARVIS routines every 15 min. The script decides which saved routines are due.
[Unit]
Description=life-dashboard schedule: routines (JARVIS routines every 15 min)

[Timer]
OnCalendar=*:00/15
Unit=lifedash-job@routines.service
Persistent=true
RandomizedDelaySec=45s
AccuracySec=30s

[Install]
WantedBy=timers.target
