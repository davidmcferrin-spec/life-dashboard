# One scheduled PHP job (replaces the Dreamhost crontab). Instance = job name:
#   feeds flights packages pings stocks shares prune media
# Run by hand: sudo systemctl start lifedash-job@feeds
# Output is appended to storage/logs/<job>.log (read by /settings/system).

[Unit]
Description=life-dashboard job: %i
After=lifedash-secrets.service postgresql.service network-online.target
Wants=network-online.target
Requires=lifedash-secrets.service

[Service]
Type=oneshot
User=lifedash
Group=lifedash
ExecStart=/srv/lifedash/app/deploy/bin/lifedash-job %i
TimeoutStartSec=20min
Nice=5

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/lifedash/app/storage
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
