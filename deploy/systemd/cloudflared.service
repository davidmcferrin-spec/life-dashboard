# Installed by lifedash-tunnel-setup. cloudflared reads /etc/cloudflared/config.yml.
# The credentials file path is in that config. It is not in this unit.

[Unit]
Description=Cloudflare Tunnel for life-dashboard
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate --config /etc/cloudflared/config.yml tunnel run
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
