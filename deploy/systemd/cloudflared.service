# Token file is written by lifedash-service-from-spool. It is root-only.
# If that file is missing, lifedash-cloudflared falls back to /etc/cloudflared/config.yml.

[Unit]
Description=Cloudflare Tunnel for life-dashboard
After=network-online.target
Wants=network-online.target

[Service]
TimeoutStartSec=15
Type=notify
ExecStart=/srv/lifedash/app/deploy/bin/lifedash-cloudflared
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
