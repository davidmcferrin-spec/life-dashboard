# Decrypts the app .env (encrypted with systemd-creds, bound to this machine's
# TPM2 when present plus the host key) into tmpfs at boot. On disk there is only
# /etc/lifedash/app.env.cred; a pulled drive yields ciphertext for the secrets.
#
# /srv/lifedash/app/.env is a symlink to /run/lifedash/app.env.
# Edit secrets with: sudo lifedash-env edit

[Unit]
Description=life-dashboard secrets (decrypt app.env to /run/lifedash)
# php-fpm is ordered after this unit by a drop-in written in provision.sh.
ConditionPathExists=/etc/lifedash/app.env.cred

[Service]
Type=oneshot
RemainAfterExit=yes
LoadCredentialEncrypted=app.env:/etc/lifedash/app.env.cred
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g lifedash /run/lifedash
ExecStart=/usr/bin/install -m 0640 -o root -g lifedash ${CREDENTIALS_DIRECTORY}/app.env /run/lifedash/app.env
ExecStop=/usr/bin/rm -f /run/lifedash/app.env

[Install]
WantedBy=multi-user.target
