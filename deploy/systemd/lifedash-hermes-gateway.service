# Hermes API server for the dashboard chat. Loopback only.
# The API key is API_SERVER_KEY in /var/lib/lifedash/hermes/.env.

[Unit]
Description=Hermes Agent gateway
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=lifedash
Group=lifedash
Environment=HERMES_HOME=/var/lib/lifedash/hermes
Environment=HOME=/var/lib/lifedash/hermes
EnvironmentFile=/var/lib/lifedash/hermes/.env
Environment=API_SERVER_ENABLED=true
Environment=API_SERVER_HOST=127.0.0.1
Environment=API_SERVER_PORT=8642
WorkingDirectory=/var/lib/lifedash/hermes
ExecStart=/var/lib/lifedash/hermes/.local/bin/hermes gateway
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/lifedash/hermes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes

[Install]
WantedBy=multi-user.target
